{
  "functions": {
    "server.js": {
      "includeFiles": "{index.html,privacy.html,terms.html,css/**,js/**,images/**,videos/**,fonts/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(webm|mp4|png|jpg|jpeg|webp|avif|woff|woff2|ttf|svg|css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.html|/|privacy|terms|$)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
